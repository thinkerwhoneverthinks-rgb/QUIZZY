        {
          "id": "69940ff18f924373ef02c9a8",
          "question": "<p>Which of the following technique is most suitable for purification of cyclohexanone from a mixture containing benzoic acid, isoamyl alcohol, cyclohexane and cyclohexanone-</p>",
          "image_url": null,
          "images": [],
          "type": "mcq",
          "options": [
            "<p>Crystallisation</p>",
            "<p>IR spectroscopy</p>",
            "<p>Sublimation</p>",
            "<p>Gas chromatography</p>"
          ],
          "correct": 3,
          "explanation": "<p data-start=\"35\" data-end=\"346\">Cyclohexanone is a <strong data-start=\"63\" data-end=\"82\">volatile liquid</strong>, mixed here with other volatile organics (cyclohexane, isoamyl alcohol) plus a non-volatile solid (benzoic acid). <strong data-start=\"197\" data-end=\"219\" data-is-only-node=\"\">Gas chromatography</strong> separates volatile components efficiently based on their retention times, allowing collection of the cyclohexanone fraction.</p>\n<ul data-start=\"347\" data-end=\"542\" data-is-last-node=\"\" data-is-only-node=\"\">\n<li data-start=\"347\" data-end=\"466\">\n<p data-start=\"349\" data-end=\"466\"><strong data-start=\"349\" data-end=\"368\">Crystallisation</strong> and <strong data-start=\"373\" data-end=\"388\">sublimation</strong> apply to solids (benzoic acid), not for purifying the liquid cyclohexanone.</p>\n</li>\n<li data-start=\"467\" data-end=\"542\" data-is-last-node=\"\">\n<p data-start=\"469\" data-end=\"542\" data-is-last-node=\"\"><strong data-start=\"469\" data-end=\"488\">IR spectroscopy</strong> is an identification tool, not a purification method.</p>\n</li>\n</ul>"
        }
