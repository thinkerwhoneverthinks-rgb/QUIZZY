        {
          "id": "693b9c31127c96838a433a8d",
          "question": "<p>Which of the following belongs to group 8</p>",
          "image_url": null,
          "images": [],
          "type": "mcq",
          "options": [
            "<p>\\( \\mathrm{Ni}, \\mathrm{Pd}, \\mathrm{Pt} \\)</p>",
