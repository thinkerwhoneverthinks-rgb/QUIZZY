            "<p><span class=\"math inline\">\\(x\\&nbsp;&nbsp;= \\ y\\)</span> or relation can&rsquo;t be established</p>",
            "<p><span class=\"math inline\">\\(x\\&nbsp;&nbsp;\\leq \\ y\\)</span></p>",
