            "<p>999</p>",
            "<p>730</p>",
            "<p>511</p>",
            "<p>None of these</p>"
          ],
          "correct": 0,
          "explanation": "<p><span class=\"math inline\">\\(6^{3} - 1 = 215\\)</span></p>\n<p><span class=\"math inline\">\\(7^{3} + 1 = 344\\)</span></p>\n<p><span class=\"math inline\">\\(8^{3} - 1 = 511\\)</span></p>\n<p><span class=\"math inline\">\\(9^{3} + 1 = 730\\)</span></p>\n<p><span class=\"math inline\">\\(10^{3} - 1 = 999\\)</span></p>\n<p><span class=\"math inline\">\\(11^{3} + 1 = 1332\\ \\ \\ \\ \\ \\ \\ \\ \\ \\ (not\\ 1331)\\)</span> (Ans)</p>"
        },
        {
